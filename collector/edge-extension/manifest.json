{
  "manifest_version": 3,
  "name": "1688 Single Product Collector",
  "version": "0.4.7",
  "description": "Capture the current 1688 product page and send it to the local crossborder-ai-factory ingest service.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.1688.com/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集当前1688商品"
  },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-probe.js", "category-tree.zh-CN.json", "category-rules-cache.json"],
      "matches": ["https://*.1688.com/*"]
    }
  ]
}
