{
  "manifest_version": 3,
  "name": "1688 Single Product Collector",
  "version": "0.4.26",
  "description": "Capture current 1688 product pages or Ozon reference product pages into the local JLC GLOBAL workbench.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.ozon.ru/*",
    "https://*.ozone.ru/*",
    "https://*.ozonusercontent.com/*",
    "https://seerfar.cn/*",
    "https://www.seerfar.cn/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集当前商品或Ozon参考页"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.ozon.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seerfar.cn/*", "https://www.seerfar.cn/*"],
      "js": ["seerfar-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-probe.js", "category-tree.zh-CN.json", "category-rules-cache.json"],
      "matches": ["https://*.1688.com/*", "https://*.ozon.ru/*"]
    }
  ]
}
