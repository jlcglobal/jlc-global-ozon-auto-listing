      "usage_scene",
      "purchase_motivation",
      "sku"
    ]
  },
  "required_description_sections": [
    "product_value",
    "usage_scenarios",
    "core_advantages",
    "usage_method",
    "notices"
  ],
  "attribute_fields": [
    "product_type",
    "brand",
    "material",
    "dimensions",
    "weight",
    "load_capacity",
    "certifications",
    "functions",
    "package_quantity",
    "accessories"
  ],
  "upload_gate": {
    "stage35_upload_allowed": false,
    "required_for_future_upload": [
      "human_approval",
      "description_category_id",
      "type_id",
      "required_ozon_attribute_ids",
      "sale_price_rub",
      "stock",
      "warehouse_id"
    ]
  }
}
