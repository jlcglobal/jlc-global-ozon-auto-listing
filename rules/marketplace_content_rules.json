{
  "schema_version": "1.0.0",
  "title": {
    "minimum_length": 10,
    "maximum_length": 120,
    "core_keyword_max_start_index": 20,
    "forbidden_patterns": [
      "100%",
      "№1",
      "лучший",
      "гарантированно",
      "официально сертифицирован"
    ]
  },
  "keywords": {
    "primary_min": 1,
    "primary_max": 8,
    "secondary_max": 20,
    "allowed_sources": [
