{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/attributes.schema.json",
  "title": "Ozon Attribute Mapping Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "source_refs", "category_proposal", "attributes", "unknown_fields", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "source_refs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "category_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_ru", "path_hint_ru", "description_category_id", "type_id", "mapping_status"],
      "properties": {
        "name_ru": { "type": "string", "minLength": 2 },
        "path_hint_ru": { "type": "string", "minLength": 2 },
        "description_category_id": { "$ref": "#/$defs/unknownableInteger" },
        "type_id": { "$ref": "#/$defs/unknownableInteger" },
        "mapping_status": { "type": "string", "enum": ["needs_ozon_mapping", "mapped", "unknown"] }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/attribute" }
    },
    "unknown_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "unknownableInteger": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "const": "unknown" },
        { "type": "null" }
      ]
    },
    "attributeValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } },
        { "type": "null" }
      ]
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "name_ru", "ozon_attribute_id", "complex_id", "value", "source_type", "source_refs", "status"],
      "properties": {
        "field_key": { "type": "string", "enum": ["product_type", "brand", "material", "dimensions", "weight", "load_capacity", "certifications", "functions", "package_quantity", "accessories"] },
        "name_ru": { "type": "string", "minLength": 1 },
        "ozon_attribute_id": { "$ref": "#/$defs/unknownableInteger" },
        "complex_id": { "$ref": "#/$defs/unknownableInteger" },
        "value": { "$ref": "#/$defs/attributeValue" },
        "source_type": { "type": "string", "enum": ["source", "analysis", "human", "unknown"] },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "type": "string", "enum": ["confirmed", "unknown", "needs_ozon_mapping"] }
      }
    }
  }
}
