{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "status", "minimum_confidence", "candidates", "dry_run_only", "reason"],
  "properties": {
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "status": {"type": "string", "enum": ["PROPOSAL_AVAILABLE", "NO_SAFE_PROPOSAL"]},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "dry_run_only": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1}
  }
}
