{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/category-selection.schema.json",
  "title": "Collector Final Ozon Category Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "selection_source", "selected_at", "category_id", "type_id",
    "category_name_ru", "category_path", "rules_snapshot", "rules_snapshot_hash",
    "locked_for_batch", "allow_runtime_rematch"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "selection_source": {"type": "string", "const": "user_final_choice"},
    "selected_at": {"type": "string", "minLength": 1},
    "category_id": {"type": "integer", "minimum": 1},
    "type_id": {"type": "integer", "minimum": 1},
    "category_name_ru": {"type": "string", "minLength": 1},
    "category_name_zh": {"type": "string", "minLength": 1},
    "category_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "category_path_zh": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "category_label_source": {"type": "string", "const": "ozon_seller_api"},
    "category_label_language": {"type": "string", "const": "ZH_HANS"},
    "rules_snapshot_hash": {"type": "string", "minLength": 1},
    "locked_for_batch": {"type": "boolean", "const": true},
    "allow_runtime_rematch": {"type": "boolean", "const": false},
    "rules_snapshot": {
      "type": "object",
      "required": ["category_id", "type_id", "attributes", "required_attribute_ids", "aspect_attribute_ids"],
      "properties": {
        "category_id": {"type": "integer", "minimum": 1},
        "type_id": {"type": "integer", "minimum": 1},
        "attributes": {"type": "array", "minItems": 1},
        "required_attribute_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "aspect_attribute_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
