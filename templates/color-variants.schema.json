{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/color-variants.schema.json",
  "title": "Ozon Color Variants",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "variants", "summary", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "mapped", "missing"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "mapped": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "sku_name", "color", "image", "source", "resolution_level", "confidence", "status", "reason"],
      "properties": {
        "sku_id": {"type": "string", "minLength": 1},
        "sku_name": {"type": "string", "minLength": 1},
        "color": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "source": {"type": "string", "enum": ["sku_image", "sku_property_value", "main_image_match", "ai_generated", "generated_from_real_sku_reference", "missing"]},
        "resolution_level": {"type": "integer", "minimum": 1, "maximum": 4},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"type": "string", "enum": ["mapped", "missing"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
