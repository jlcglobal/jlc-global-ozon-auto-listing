{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ecommerce-creative-brief.schema.json",
  "title": "Product-specific Ozon Ecommerce Creative Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "collection_id", "source_kind", "source_refs", "product_understanding", "product_positioning", "visual_style", "image_roles", "preserve", "forbidden", "generation_order", "processing"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "collection_id": {"type": "string", "pattern": "^COL-[A-Za-z0-9._-]{8,80}$"},
    "source_kind": {"const": "workbench_collection"},
    "source_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "designer_ref": {"type": "string", "minLength": 1},
    "product_understanding": {"type": "object"},
    "product_positioning": {"type": "object"},
    "visual_style": {"type": "object"},
    "main_image_roles": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/designerRole"}},
    "image_roles": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"oneOf": [{"$ref": "#/$defs/role"}, {"$ref": "#/$defs/designerRole"}]}},
    "preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generation_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "processing": {"type": "object", "required": ["step", "status", "generated_at", "error"], "properties": {"step": {"const": "ecommerce_creative_brief"}, "status": {"const": "completed"}, "generated_at": {"type": "string"}, "error": {"type": ["string", "null"]}}}
  },
  "$defs": {
    "designerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "layout_type", "commercial_purpose", "buyer_question", "source_references", "russian_text", "prompt", "operation", "overlay_modules", "must_preserve", "design_rationale", "art_direction", "overlay_plan"],
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "sku_id": {"type": "string", "minLength": 1},
        "layout_type": {"type": "string", "minLength": 1},
        "commercial_purpose": {"type": "string", "minLength": 1},
        "buyer_question": {"type": "string", "minLength": 1},
        "source_references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "russian_text": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prompt": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "enum": ["compose_from_real_images", "edit_real_image"]},
        "overlay_modules": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "design_rationale": {"type": "string", "minLength": 30},
        "art_direction": {"type": "object", "minProperties": 10},
        "overlay_plan": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object"}}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role_id", "image_type", "commercial_purpose", "buyer_question", "russian_text", "operation", "source_references", "sku_scope", "must_prove"],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 8},
        "role_id": {"type": "string", "minLength": 1},
        "image_type": {"type": "string", "minLength": 1},
        "commercial_purpose": {"type": "string", "minLength": 1},
        "buyer_question": {"type": "string", "minLength": 1},
        "russian_text": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "operation": {"type": "string", "enum": ["compose_from_real_images", "edit_real_image"]},
        "source_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sku_scope": {"const": "shared"},
        "must_prove": {"type": "string", "minLength": 1}
      }
    }
  }
}
