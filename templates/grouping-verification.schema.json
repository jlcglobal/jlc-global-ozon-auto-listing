{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/grouping-verification.schema.json",
  "title": "Ozon Product Grouping Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_group_id", "checked_at", "offer_count", "offers", "grouping_status", "errors", "warnings", "last_api_response", "last_attribute_response"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_group_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "archive_status": {"type": "string"},
    "expected_group_count": {"type": "integer", "minimum": 1},
    "expected_card_count": {"type": "integer", "minimum": 1},
    "offer_count": {"type": "integer", "minimum": 1},
    "offers": {
      "type": "array", "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/legacyOffer"}, {"$ref": "#/$defs/remoteOffer"}]}
    },
    "grouping_status": {"type": "string", "enum": ["pending", "grouped", "not_grouped", "failed"]},
    "grouped_card_id": {"type": ["integer", "string", "null"]},
    "grouped_card_url": {"type": ["string", "null"]},
    "timed_out": {"type": "boolean"},
    "errors": {"type": "array", "items": {}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_api_response": {"type": "object", "additionalProperties": true},
    "last_attribute_response": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "legacyOffer": {
      "type": "object", "additionalProperties": false,
      "required": ["offer_id", "ozon_product_id", "expected_ozon_product_id", "model_id", "model_attribute_id", "model_value", "expected_model_value", "variant_attribute_id", "variant_value", "expected_variant_value", "update_status", "moderation_status"],
      "properties": {
        "offer_id": {"type": "string", "minLength": 1},
        "ozon_product_id": {"type": ["integer", "string"]},
        "expected_ozon_product_id": {"type": ["integer", "string"]},
        "model_id": {"type": ["integer", "string", "null"]},
        "model_attribute_id": {"type": "integer"},
        "model_value": {"type": "string", "minLength": 1},
        "expected_model_value": {"type": "string", "minLength": 1},
        "variant_attribute_id": {"type": "integer"},
        "variant_value": {"type": "string", "minLength": 1},
        "expected_variant_value": {"type": "string", "minLength": 1},
        "update_status": {"type": "string", "minLength": 1},
        "moderation_status": {"type": "string", "minLength": 1}
      }
    },
    "remoteOffer": {
      "type": "object", "additionalProperties": false,
      "required": ["offer_id", "ozon_product_id", "color", "image", "status", "moderation_status"],
      "properties": {
        "offer_id": {"type": "string", "minLength": 1},
        "ozon_product_id": {"type": ["integer", "string"]},
        "color": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "moderation_status": {"type": "string", "minLength": 1}
      }
    }
  }
}
