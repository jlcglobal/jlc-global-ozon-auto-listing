{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/image-asset-contract.schema.json",
  "title": "Physical Image Asset Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "collection_id", "source_kind", "manual_confirmation_required", "candidate_root", "accepted_root", "rejected_root"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "collection_id": {"type": "string", "pattern": "^COL-[A-Za-z0-9._-]{8,80}$"},
    "source_kind": {"const": "workbench_collection"},
    "manual_confirmation_required": {"type": "boolean"},
    "candidate_root": {"type": "string", "pattern": "^products/P[0-9]{6}/output/generated-images$"},
    "accepted_root": {"type": "string", "pattern": "^products/P[0-9]{6}/output/accepted-images$"},
    "rejected_root": {"type": "string", "pattern": "^products/P[0-9]{6}/output/rejected-generation$"}
  }
}
