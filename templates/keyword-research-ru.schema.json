{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/keyword-research-ru.schema.json",
  "title": "Ozon Russia Keyword Research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "product_id", "target_market", "language", "generated_at",
    "seed_terms", "approved_keywords", "excluded_keywords", "metrics_notice"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "target_market": {"type": "string", "const": "Ozon Russia"},
    "language": {"type": "string", "const": "ru"},
    "generated_at": {"type": "string", "format": "date-time"},
    "seed_terms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "approved_keywords": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyword", "intent", "source", "evidence", "volume", "difficulty"],
        "properties": {
          "keyword": {"type": "string", "minLength": 2},
          "intent": {"type": "string", "enum": ["transactional", "commercial", "informational"]},
          "source": {"type": "string", "enum": ["source_fact", "ozon_public_search", "ozon_seller_metadata"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "volume": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "const": "unknown"}]},
          "difficulty": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "string", "const": "unknown"}]}
        }
      }
    },
    "excluded_keywords": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyword", "reason"],
        "properties": {
          "keyword": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "metrics_notice": {"type": "string", "minLength": 1}
  }
}
