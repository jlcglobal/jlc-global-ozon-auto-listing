{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/keywords-ru.schema.json",
  "title": "Ozon Russian Search Keywords",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "source_refs", "primary_keywords", "secondary_keywords", "keyword_basis", "excluded_keywords", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "source_refs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "primary_keywords": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "secondary_keywords": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "keyword_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword", "source", "evidence"],
        "properties": {
          "keyword": { "type": "string", "minLength": 2 },
          "source": { "type": "string", "enum": ["product_type", "usage_scene", "purchase_motivation", "sku"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "excluded_keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
