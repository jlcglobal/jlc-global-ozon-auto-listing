{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/merge-field-diff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fetched_at",
    "product_group_id",
    "archive_status",
    "offers",
    "differences",
    "common_field_conflicts",
    "source_snapshot"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "product_group_id": {"type": "string", "minLength": 1},
    "archive_status": {"type": "string", "const": "manually_archived"},
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": true}
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "attribute_id", "classification", "origin", "values_by_offer"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "attribute_id": {"type": ["integer", "null"]},
          "classification": {
            "type": "string",
            "enum": [
              "allowed_variant_difference",
              "public_field_conflict",
              "system_generated_difference"
            ]
          },
          "origin": {"type": "string", "minLength": 1},
          "values_by_offer": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "common_field_conflicts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_snapshot": {"type": "string", "minLength": 1}
  }
}
