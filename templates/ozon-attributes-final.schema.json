{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-attributes-final.schema.json",
  "title": "Ozon Final Attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "category_id", "type_id", "schema_source", "attributes", "required_summary", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "category_id": {"type": "integer", "minimum": 1},
    "type_id": {"type": "integer", "minimum": 1},
    "schema_source": {"type": "string", "const": "ozon_seller_api"},
    "attributes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attribute"}},
    "required_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "filled", "missing", "missing_attribute_ids"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "filled": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "missing_attribute_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute_id", "attribute_name", "required", "value", "source", "confidence", "dictionary_value_id", "evidence"],
      "properties": {
        "attribute_id": {"type": "integer", "minimum": 1},
        "attribute_name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "value": {"type": ["string", "number"], "minLength": 1},
        "source": {"type": "string", "enum": ["1688", "AI_estimated", "workspace_default", "human_override", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dictionary_value_id": {"type": ["integer", "null"], "minimum": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
