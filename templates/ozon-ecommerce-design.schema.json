{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-ecommerce-design.schema.json",
  "title": "Unified Ozon Ecommerce Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "collection_id",
    "source_kind",
    "source_refs",
    "product_understanding",
    "buyer_strategy",
    "listing",
    "attribute_plan",
    "attribute_decisions",
    "sku_plan",
    "visual_system",
    "main_images",
    "detail_images",
    "forbidden",
    "decision_trace",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "product_id": {
      "type": "string",
      "pattern": "^P[0-9]{6}$"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^COL-[A-Za-z0-9._-]{8,80}$"
    },
    "source_kind": {
      "const": "workbench_collection"
    },
    "source_refs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product_understanding": {
      "type": "object"
    },
    "buyer_strategy": {
      "type": "object"
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seo_title_ru",
        "short_title_ru",
        "description_ru",
        "description_sections",
        "selling_points",
        "keywords",
        "hashtags"
      ],
      "properties": {
        "seo_title_ru": {
          "type": "string",
          "minLength": 25
        },
        "short_title_ru": {
          "type": "string",
          "minLength": 8
        },
        "description_ru": {
          "type": "string",
          "minLength": 300
        },
        "description_sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_value",
            "usage_scenarios",
            "core_advantages",
            "usage_method",
            "notices"
          ],
          "properties": {
            "product_value": {
              "type": "string",
              "minLength": 30
            },
            "usage_scenarios": {
              "type": "string",
              "minLength": 30
            },
            "core_advantages": {
              "type": "string",
              "minLength": 30
            },
            "usage_method": {
              "type": "string",
              "minLength": 30
            },
            "notices": {
              "type": "string",
              "minLength": 30
            }
          }
        },
        "selling_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "keywords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "long_tail",
            "scene",
            "excluded"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/keywords"
            },
            "long_tail": {
              "$ref": "#/$defs/keywords"
            },
            "scene": {
              "$ref": "#/$defs/keywords"
            },
            "excluded": {
              "$ref": "#/$defs/keywords"
            }
          }
        },
        "hashtags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "type": "string",
            "pattern": "^#[А-Яа-яЁё]+$",
            "minLength": 3,
            "maxLength": 30
          }
        }
      }
    },
    "attribute_plan": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attribute_decisions": {
      "$ref": "#/$defs/attributeDecisions"
    },
    "sku_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/sku"
      }
    },
    "visual_system": {
      "$ref": "#/$defs/visualSystem"
    },
    "main_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "detail_images": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decision_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "compliance_status",
        "violations",
        "attempt"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/decisionStep"
          }
        },
        "compliance_status": {
          "const": "PASS"
        },
        "violations": {
          "type": "array",
          "maxItems": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "status",
        "model_mode",
        "generated_at",
        "error"
      ],
      "properties": {
        "step": {
          "const": "ecommerce_design"
        },
        "status": {
          "const": "completed"
        },
        "model_mode": {
          "const": "connected_codex"
        },
        "generated_at": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "keywords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_ru",
        "intent",
        "source_refs",
        "metrics"
      ],
      "properties": {
        "text_ru": {
          "type": "string",
          "minLength": 2
        },
        "intent": {
          "type": "string",
          "minLength": 2
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "string",
          "const": "unknown"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_ru",
        "claim_type",
        "source_refs"
      ],
      "properties": {
        "text_ru": {
          "type": "string",
          "minLength": 4
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "fact",
            "estimated",
            "supported_inference"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sku": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku_id",
        "name_ru",
        "difference_ru",
        "specification",
        "source_image"
      ],
      "properties": {
        "sku_id": {
          "type": "string",
          "minLength": 1
        },
        "name_ru": {
          "type": "string",
          "minLength": 2
        },
        "difference_ru": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "object"
        },
        "source_image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attributeDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_hash",
        "common_attributes",
        "attributes_by_sku",
        "coverage_summary"
      ],
      "properties": {
        "input_hash": {
          "type": "string",
          "minLength": 16
        },
        "common_attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attributeDecision"
          }
        },
        "attributes_by_sku": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attributeDecision"
            }
          }
        },
        "coverage_summary": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "total_realtime_attributes",
            "decided_attributes"
          ],
          "properties": {
            "total_realtime_attributes": {
              "type": "integer",
              "minimum": 0
            },
            "decided_attributes": {
              "type": "integer",
              "minimum": 0
            },
            "unknown_high_risk_attribute_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "skipped_optional_attribute_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "attributeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute_id",
        "attribute_name",
        "scope",
        "raw_semantic_value",
        "ozon_value",
        "dictionary_value_id",
        "source_refs",
        "decision_status"
      ],
      "properties": {
        "attribute_id": {
          "type": "integer",
          "minimum": 1
        },
        "attribute_name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "common",
            "sku"
          ]
        },
        "raw_semantic_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "ozon_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "dictionary_value_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_status": {
          "type": "string",
          "enum": [
            "filled",
            "unknown_high_risk",
            "not_applicable",
            "skipped_optional"
          ]
        },
        "physical_dimension": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "weight",
            "capacity",
            "load",
            "quantity",
            "dimension",
            "color",
            "material",
            "brand",
            "text",
            "boolean",
            null
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "layout_type",
        "commercial_purpose",
        "buyer_question",
        "image_role",
        "customer_question",
        "visual_goal",
        "shot_type",
        "composition",
        "must_show",
        "avoid",
        "source_references",
        "russian_text",
        "prompt",
        "operation",
        "overlay_modules",
        "must_preserve",
        "design_rationale",
        "art_direction",
        "overlay_plan"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "sku_id": {
          "type": "string",
          "minLength": 1
        },
        "layout_type": {
          "type": "string",
          "enum": [
            "sku_main",
            "core_benefit",
            "structure_callout",
            "usage_scene",
            "sku_comparison",
            "purchase_notice"
          ]
        },
        "commercial_purpose": {
          "type": "string",
          "minLength": 4
        },
        "buyer_question": {
          "type": "string",
          "minLength": 4
        },
        "image_role": {
          "type": "string",
          "minLength": 4,
          "description": "Product-specific buyer-decision role for this image; not a fixed visual template name."
        },
        "customer_question": {
          "type": "string",
          "minLength": 4,
          "description": "Concrete shopping question this image answers for the buyer."
        },
        "visual_goal": {
          "type": "string",
          "minLength": 8,
          "description": "What the buyer should visually understand or believe after viewing this image."
        },
        "shot_type": {
          "type": "string",
          "minLength": 4,
          "description": "Camera and distance task, e.g. full product hero, macro close-up, 85mm macro detail, angled close crop, top-down layout, medium lifestyle scene or wide room context."
        },
        "composition": {
          "type": "string",
          "minLength": 12,
          "description": "Frame-level composition describing product/crop/environment/text placement for this slot."
        },
        "must_show": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Visible product elements or factual proof points that must appear in this image."
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Product-specific visual mistakes, factual inventions and composition failures forbidden in this slot."
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "russian_text": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 120
        },
        "operation": {
          "type": "string",
          "enum": [
            "edit_real_image",
            "compose_from_real_images",
            "generate_from_reference"
          ]
        },
        "overlay_modules": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "product_name",
              "callout_arrows",
              "dimension_lines",
              "sku_labels",
              "purchase_notice"
            ]
          }
        },
        "must_preserve": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "design_rationale": {
          "type": "string",
          "minLength": 8
        },
        "art_direction": {
          "$ref": "#/$defs/artDirection"
        },
        "overlay_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/overlayInstruction"
          }
        }
      }
    },
    "visualSystem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "style_name",
        "value_impression",
        "palette_logic",
        "scene_logic",
        "typography_logic",
        "consistency_rule",
        "anti_template_rule",
        "photography_world",
        "lens_plan",
        "reference_editing_rule",
        "material_value_signal",
        "scene_variety_rule"
      ],
      "properties": {
        "style_name": {
          "type": "string",
          "minLength": 4
        },
        "value_impression": {
          "type": "string",
          "minLength": 12
        },
        "palette_logic": {
          "type": "string",
          "minLength": 12
        },
        "scene_logic": {
          "type": "string",
          "minLength": 12
        },
        "typography_logic": {
          "type": "string",
          "minLength": 12
        },
        "consistency_rule": {
          "type": "string",
          "minLength": 12
        },
        "anti_template_rule": {
          "type": "string",
          "minLength": 12
        },
        "photography_world": {
          "type": "string",
          "minLength": 30
        },
        "lens_plan": {
          "type": "string",
          "minLength": 30
        },
        "reference_editing_rule": {
          "type": "string",
          "minLength": 30
        },
        "material_value_signal": {
          "type": "string",
          "minLength": 30
        },
        "scene_variety_rule": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "scene",
        "composition",
        "product_scale_percent",
        "product_position",
        "background",
        "palette",
        "lighting",
        "typography",
        "iconography",
        "information_hierarchy",
        "negative_space",
        "value_signal",
        "slot_differentiation"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 4
        },
        "scene": {
          "type": "string",
          "minLength": 4
        },
        "composition": {
          "type": "string",
          "minLength": 4
        },
        "product_scale_percent": {
          "type": "integer",
          "minimum": 20,
          "maximum": 85
        },
        "product_position": {
          "type": "string",
          "minLength": 4
        },
        "background": {
          "type": "string",
          "minLength": 8
        },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "lighting": {
          "type": "string",
          "minLength": 8
        },
        "typography": {
          "type": "string",
          "minLength": 8
        },
        "iconography": {
          "type": "string",
          "minLength": 4
        },
        "information_hierarchy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "negative_space": {
          "type": "string",
          "minLength": 8
        },
        "value_signal": {
          "type": "string",
          "minLength": 4
        },
        "slot_differentiation": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "overlayInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text",
        "box",
        "font_size_ratio",
        "font_weight",
        "text_color",
        "accent_color",
        "background_style",
        "background_color",
        "accent_style",
        "align",
        "vertical_align",
        "priority"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "benefit",
            "specification",
            "callout",
            "notice"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 2
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "font_size_ratio": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.12
        },
        "font_weight": {
          "type": "string",
          "enum": [
            "regular",
            "bold"
          ]
        },
        "text_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_style": {
          "type": "string",
          "enum": [
            "none",
            "solid",
            "translucent",
            "pill",
            "circle"
          ]
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_style": {
          "type": "string",
          "enum": [
            "none",
            "top_line",
            "left_line",
            "underline",
            "check_icon"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "vertical_align": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "decisionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "const": "completed"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}