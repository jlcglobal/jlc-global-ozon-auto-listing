{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-images.schema.json",
  "title": "Ozon Image Transfer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "hosting_mode", "tunnel_url", "images", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "hosting_mode": {"type": "string", "enum": ["pending_tunnel", "cloudflare_quick_tunnel", "background_tunnel", "submitted", "completed"]},
    "tunnel_url": {"$ref": "#/$defs/unknownableString"},
    "images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "unknownableString": {"type": ["string", "null"], "minLength": 1},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "role", "local_path", "staged_name", "public_url", "sha256", "status", "ozon_image_id", "ozon_url", "error"],
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["main", "variant_main", "detail", "disclaimer", "color"]},
        "source_sku_id": {"$ref": "#/$defs/unknownableString"},
        "local_path": {"type": "string", "minLength": 1},
        "staged_name": {"type": "string", "minLength": 1},
        "public_url": {"$ref": "#/$defs/unknownableString"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"type": "string", "enum": ["pending", "served", "submitted", "imported", "failed"]},
        "ozon_image_id": {"$ref": "#/$defs/unknownableString"},
        "ozon_url": {"$ref": "#/$defs/unknownableString"},
        "error": {"$ref": "#/$defs/unknownableString"}
      }
    }
  }
}
