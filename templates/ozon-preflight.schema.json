{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-preflight.schema.json",
  "title": "Stage 4.1 Ozon Metadata Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "product_id", "checked_at", "metadata_source", "status",
    "upload_allowed", "missing_required_attributes", "invalid_values", "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "checked_at": { "type": "string", "format": "date-time" },
    "metadata_source": { "type": "string", "const": "ozon_seller_api" },
    "status": { "type": "string", "enum": ["failed", "blocked_read_only"] },
    "upload_allowed": { "type": "boolean", "const": false },
    "missing_required_attributes": { "type": "array", "items": { "$ref": "#/$defs/missingAttribute" } },
    "invalid_values": { "type": "array", "items": { "$ref": "#/$defs/invalidValue" } },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "missingAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute_id", "attribute_name"],
      "properties": {
        "attribute_id": { "type": "integer", "minimum": 1 },
        "attribute_name": { "type": "string", "minLength": 1 }
      }
    },
    "invalidValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute_id", "attribute_name", "value", "reason"],
      "properties": {
        "attribute_id": { "type": "integer", "minimum": 1 },
        "attribute_name": { "type": "string", "minLength": 1 },
        "value": {},
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
