{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-reference-designer-input.schema.json",
  "title": "Ozon Reference Designer Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source_kind",
    "source_url",
    "generated_at",
    "ready_for_ai_design",
    "mode",
    "inventory_submission_enabled",
    "operator_inputs",
    "seo_reference",
    "visual_reference",
    "copy_contract",
    "image_contract",
    "attribute_contract",
    "forbidden",
    "outputs_expected",
    "write_api_calls",
    "inventory_api_calls"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "source_kind": {"const": "ozon_reference_listing"},
    "source_url": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "ready_for_ai_design": {"type": "boolean"},
    "mode": {"const": "create_without_inventory"},
    "inventory_submission_enabled": {"const": false},
    "operator_inputs": {"type": "object", "additionalProperties": true},
    "seo_reference": {"type": "object", "additionalProperties": true},
    "visual_reference": {"type": "object", "additionalProperties": true},
    "copy_contract": {"type": "object", "additionalProperties": true},
    "image_contract": {"type": "object", "additionalProperties": true},
    "attribute_contract": {"type": "object", "additionalProperties": true},
    "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs_expected": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "write_api_calls": {"const": 0},
    "inventory_api_calls": {"const": 0}
  }
}
