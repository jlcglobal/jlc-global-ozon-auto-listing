{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-tags.schema.json",
  "title": "Ozon Search Tags",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "tags", "count", "language", "source_refs", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "tags": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[А-Яа-яЁё0-9]+$", "minLength": 2, "maxLength": 60}
    },
    "count": {"type": "integer", "const": 30},
    "language": {"type": "string", "const": "ru"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
