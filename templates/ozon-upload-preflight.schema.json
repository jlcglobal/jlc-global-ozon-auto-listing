{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/ozon-upload-preflight.schema.json",
  "title": "Ozon Upload Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "shop_name", "checked_at", "upload_allowed", "checks", "missing_required_attributes", "invalid_values", "errors", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "shop_name": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "upload_allowed": {"type": "boolean"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "missing_required_attributes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "invalid_values": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{
    "if": {"properties": {"upload_allowed": {"const": true}}},
    "then": {
      "properties": {
        "missing_required_attributes": {"maxItems": 0},
        "invalid_values": {"maxItems": 0},
        "errors": {"maxItems": 0}
      }
    }
  }],
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
