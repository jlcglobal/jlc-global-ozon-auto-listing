{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/product-analysis.schema.json",
  "title": "Codex Product Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "source_refs",
    "facts",
    "selling_points",
    "inferences",
    "unknowns",
    "risks",
    "recommendation",
    "processing"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "$ref": "#/$defs/productId" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "product_type": { "$ref": "#/$defs/unknownableString" },
    "category": { "$ref": "#/$defs/unknownableString" },
    "target_customer": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
    "usage_scenarios": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
    "competitive_advantages": { "type": "array", "items": { "$ref": "#/$defs/evidenceText" } },
    "missing_information": { "type": "array", "items": { "$ref": "#/$defs/unknown" } },
    "recommended": { "$ref": "#/$defs/unknownableString" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_cn",
        "category_cn",
        "brand",
        "materials",
        "dimensions",
        "weight",
        "load_capacity",
        "certifications",
        "functions",
        "package_quantity",
        "accessories",
        "skus"
      ],
      "properties": {
        "title_cn": { "$ref": "#/$defs/unknownableString" },
        "category_cn": { "$ref": "#/$defs/unknownableString" },
        "brand": { "$ref": "#/$defs/unknownableString" },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
        "dimensions": { "$ref": "#/$defs/unknownableObject" },
        "weight": { "$ref": "#/$defs/unknownableObject" },
        "load_capacity": { "$ref": "#/$defs/unknownableObject" },
        "certifications": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
        "package_quantity": { "$ref": "#/$defs/unknownableObject" },
        "accessories": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
        "skus": { "type": "array", "items": { "$ref": "#/$defs/analyzedSku" } }
      }
    },
    "selling_points": { "type": "array", "items": { "$ref": "#/$defs/evidenceText" } },
    "inferences": { "type": "array", "items": { "$ref": "#/$defs/inference" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/unknown" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "type": "string", "enum": ["continue", "needs_human_input", "reject", "unknown"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "processing": { "$ref": "#/$defs/processingStep" }
  },
  "$defs": {
    "productId": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "unknownableString": { "type": ["string", "null"], "minLength": 1 },
    "unknownableObject": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "string", "const": "unknown" },
        { "type": "null" }
      ]
    },
    "evidenceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "analyzedSku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "name_cn", "properties", "price_cny", "image_refs"],
      "properties": {
        "sku_id": { "$ref": "#/$defs/unknownableString" },
        "name_cn": { "$ref": "#/$defs/unknownableString" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/unknownableString" } },
        "price_cny": { "type": ["number", "null"], "minimum": 0 },
        "image_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "confidence", "basis"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "value": {},
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "needed_from_human"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "needed_from_human": { "type": "boolean" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "level", "message", "blocking"],
      "properties": {
        "area": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "processingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "status", "started_at", "finished_at", "error"],
      "properties": {
        "step": { "type": "string", "const": "product_analysis" },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "failed", "retryable"] },
        "started_at": { "$ref": "#/$defs/unknownableString" },
        "finished_at": { "$ref": "#/$defs/unknownableString" },
        "error": { "$ref": "#/$defs/unknownableString" }
      }
    }
  }
}
