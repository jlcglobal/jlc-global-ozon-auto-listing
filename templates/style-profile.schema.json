{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/style-profile.schema.json",
  "title": "Product Image Style Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "generated_at",
    "classification_status",
    "source_refs",
    "category_primary",
    "category_secondary",
    "target_user",
    "purchase_motivation",
    "usage_scene",
    "price_positioning",
    "purchase_mode",
    "style_family",
    "style_template_ref",
    "image_strategy",
    "tone",
    "color_direction",
    "composition_style",
    "text_style",
    "image_set_structure",
    "selection_evidence",
    "matched_rules",
    "confidence",
    "generator_constraints"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "$ref": "#/$defs/productId" },
    "generated_at": { "$ref": "#/$defs/unknownableString" },
    "classification_status": {
      "type": "string",
      "enum": ["selected", "needs_review", "needs_input"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "positioning_ref": { "type": "string", "minLength": 1 },
    "category_primary": { "$ref": "#/$defs/unknownableString" },
    "category_secondary": { "$ref": "#/$defs/unknownableString" },
    "target_user": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
    "purchase_motivation": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
    "usage_scene": { "type": "array", "items": { "$ref": "#/$defs/unknownableString" } },
    "price_positioning": {
      "type": "string",
      "enum": ["budget", "mass_market", "mid_range", "premium", "unknown"]
    },
    "purchase_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_driven", "lifestyle_driven", "problem_solution_driven", "dominant"],
      "properties": {
        "parameter_driven": { "type": "integer", "minimum": 0 },
        "lifestyle_driven": { "type": "integer", "minimum": 0 },
        "problem_solution_driven": { "type": "integer", "minimum": 0 },
        "dominant": {
          "type": "string",
          "enum": ["parameter", "lifestyle", "problem_solution", "balanced", "unknown"]
        }
      }
    },
    "style_family": { "$ref": "#/$defs/styleFamily" },
    "style_template_ref": { "type": "string", "minLength": 1 },
    "image_strategy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tone": { "$ref": "#/$defs/unknownableString" },
    "color_direction": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "composition_style": { "$ref": "#/$defs/unknownableString" },
    "text_style": { "$ref": "#/$defs/unknownableString" },
    "image_set_structure": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_visual_thesis", "target_buyer", "click_hook", "hero_scene",
        "buyer_tension", "visual_mood", "palette_logic", "lighting",
        "composition", "typography", "consistency_rule", "anti_template_rule"
      ],
      "properties": {
        "product_visual_thesis": { "type": "string", "minLength": 1 },
        "target_buyer": { "type": "string", "minLength": 1 },
        "click_hook": { "type": "string", "minLength": 1 },
        "hero_scene": { "type": "string", "minLength": 1 },
        "buyer_tension": { "type": "string", "minLength": 1 },
        "visual_mood": { "type": "string", "minLength": 1 },
        "palette_logic": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "consistency_rule": { "type": "string", "minLength": 1 },
        "anti_template_rule": { "type": "string", "minLength": 1 }
      }
    },
    "learned_image_preferences": { "type": "array", "items": { "type": "object" } },
    "selection_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "matched_rules": { "type": "array", "items": { "$ref": "#/$defs/matchedRule" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generator_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_visual_signals", "forbidden_visual_signals", "truthfulness_guardrails"],
      "properties": {
        "required_visual_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbidden_visual_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "truthfulness_guardrails": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "productId": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "unknownableString": { "type": ["string", "null"], "minLength": 1 },
    "styleFamily": {
      "type": "string",
      "enum": [
        "electronics_clean_tech",
        "outdoor_rugged_lifestyle",
        "kitchen_warm_home",
        "home_minimal_organized",
        "pet_friendly_lifestyle",
        "beauty_clean_premium",
        "baby_safe_soft",
        "auto_practical_performance",
        "portable_kitchen_appliance_fresh",
        "fresh_fridge_organization",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "value", "source_refs"],
      "properties": {
        "signal": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "matchedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "style_family", "score", "matched_signals"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "style_family": { "$ref": "#/$defs/styleFamily" },
        "score": { "type": "integer", "minimum": 0 },
        "matched_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
