{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/title-ru.schema.json",
  "title": "Ozon Russian Product Title",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "source_refs", "title_ru", "core_keyword", "evidence", "excluded_claims", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "product_id": { "$ref": "#/$defs/productId" },
    "source_refs": { "$ref": "#/$defs/sourceRefs" },
    "title_ru": { "type": "string", "minLength": 10, "maxLength": 120 },
    "core_keyword": { "type": "string", "minLength": 2 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "excluded_claims": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "productId": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "sourceRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
