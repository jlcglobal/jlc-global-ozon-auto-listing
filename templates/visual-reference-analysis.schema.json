{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crossborder-ai-factory/templates/visual-reference-analysis.schema.json",
  "title": "Ozon Visual Reference Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "source_kind",
    "provider",
    "reference_images",
    "real_photo_style",
    "shot_recipes",
    "negative_style",
    "fact_policy",
    "processing"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{6}$"},
    "source_kind": {"type": "string", "enum": ["ozon_reference_images", "competitor_reference_based"]},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "endpoint"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["local_florence2_visionapi", "manual_or_external_import"]},
        "endpoint": {"type": ["string", "null"]}
      }
    },
    "reference_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "caption", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["ozon_competitor_reference", "seller_real_photo_reference", "manual_reference"]}
        }
      }
    },
    "real_photo_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_feel", "lighting", "background", "depth_of_field", "texture", "imperfections"],
      "properties": {
        "camera_feel": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "depth_of_field": {"type": "string", "minLength": 1},
        "texture": {"type": "string", "minLength": 1},
        "imperfections": {"type": "string", "minLength": 1}
      }
    },
    "shot_recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_type", "composition", "purpose", "avoid"],
        "properties": {
          "shot_type": {"type": "string", "minLength": 1},
          "composition": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "avoid": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "negative_style": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_is_not_product_fact", "forbidden_fact_sources", "allowed_usage"],
      "properties": {
        "reference_is_not_product_fact": {"const": true},
        "forbidden_fact_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_usage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "status", "generated_at", "error"],
      "properties": {
        "step": {"const": "visual_reference_analysis"},
        "status": {"type": "string", "enum": ["completed", "failed"]},
        "generated_at": {"type": "string", "minLength": 1},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
